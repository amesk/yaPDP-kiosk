[Unit]
Description=yaPDP kiosk F1-F12 keyboard filter
After=systemd-udevd.service
Before=display-manager.service
ConditionPathExists=/usr/local/lib/yapdp-kiosk/kiosk-guard.py
ConditionKernelCommandLine=!yapdp.service_mode=1

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/yapdp-kiosk/kiosk-guard.py
Restart=on-failure
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
DeviceAllow=/dev/input/event* rw
DeviceAllow=/dev/uinput rw
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
